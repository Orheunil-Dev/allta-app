{
  "cli": {
    "version": ">=16.19.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "remote",
      "environment": "development"
    },
    "preview": {
      "autoIncrement": true,
      "developmentClient": false,
      "distribution": "internal",
      "credentialsSource": "remote",
      "environment": "preview"
    },
    "production": {
      "autoIncrement": true,
      "developmentClient": false,
      "distribution": "store",
      "credentialsSource": "remote",
      "environment": "production"
    }
  }
}
